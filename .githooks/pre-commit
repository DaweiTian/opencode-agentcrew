#!/bin/sh
# Agent consistency gate — enable via: git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File scripts/check-agents.ps1 || exit 1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -File scripts/check-agents.ps1 || exit 1
else
  echo "WARNING: pwsh not found — agent consistency check skipped" >&2
fi
